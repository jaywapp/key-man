<Window x:Class="KeyMan.AddCredentialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="새 키 추가" Height="660" Width="500" MinHeight="520" MinWidth="460"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindowStyle}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="새 키 또는 토큰" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="민감값은 Windows 자격 증명 관리자에 저장됩니다."
                       Margin="0,7,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0" Focusable="False">
            <StackPanel>
                <Label Content="이름 *" Target="{Binding ElementName=NameTextBox}" />
                <TextBox x:Name="NameTextBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,14" MaxLength="100" AutomationProperties.Name="이름, 필수" />
                <Label Content="서비스" Target="{Binding ElementName=ServiceTextBox}" />
                <TextBox x:Name="ServiceTextBox" Text="{Binding Service, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,14" MaxLength="100" AutomationProperties.Name="서비스" />
                <Label Content="환경" Target="{Binding ElementName=EnvironmentComboBox}" />
                <ComboBox x:Name="EnvironmentComboBox" IsEditable="True" ItemsSource="{Binding Environments}"
                          Text="{Binding Environment, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,0,14" AutomationProperties.Name="환경" />
                <Label Content="키 / 토큰 *" Target="{Binding ElementName=SecretPasswordBox}" />
                <PasswordBox x:Name="SecretPasswordBox" PasswordChanged="SecretPasswordBox_PasswordChanged"
                             Margin="0,0,0,14" MaxLength="1280" AutomationProperties.Name="키 또는 토큰, 필수" />
                <Label Content="만료일 (선택)" Target="{Binding ElementName=ExpirationDatePicker}" />
                <DatePicker x:Name="ExpirationDatePicker" SelectedDate="{Binding ExpirationDate}"
                            Margin="0,0,0,14" AutomationProperties.Name="만료일, 선택" />
                <Label Content="메모" Target="{Binding ElementName=NotesTextBox}" />
                <TextBox x:Name="NotesTextBox" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="72"
                         AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="메모" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <TextBlock x:Name="ErrorTextBlock" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,0,0,12" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="취소" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="SaveButton" Content="저장" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
