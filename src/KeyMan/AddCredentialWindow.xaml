<Window x:Class="KeyMan.AddCredentialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="새 키 추가" Height="600" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="새 키 또는 토큰" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="민감값은 Windows 자격 증명 관리자에 저장됩니다."
                       Margin="0,7,0,22" Foreground="#64748B" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="이름 *" Margin="0,0,0,5" />
                <TextBox x:Name="NameTextBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,14" MaxLength="100" />
                <TextBlock Text="서비스" Margin="0,0,0,5" />
                <TextBox Text="{Binding Service, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,14" MaxLength="100" />
                <TextBlock Text="환경" Margin="0,0,0,5" />
                <ComboBox IsEditable="True" Padding="7" ItemsSource="{Binding Environments}"
                          Text="{Binding Environment, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,0,14" />
                <TextBlock Text="키 / 토큰 *" Margin="0,0,0,5" />
                <PasswordBox x:Name="SecretPasswordBox" PasswordChanged="SecretPasswordBox_PasswordChanged"
                             Padding="9,7" Margin="0,0,0,14" MaxLength="1280" />
                <TextBlock Text="만료일 (선택)" Margin="0,0,0,5" />
                <DatePicker SelectedDate="{Binding ExpirationDate}" Padding="5" Margin="0,0,0,14" />
                <TextBlock Text="메모" Margin="0,0,0,5" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="72" AcceptsReturn="True"
                         TextWrapping="Wrap" MaxLength="500" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="취소" IsCancel="True" />
            <Button Content="저장" Command="{Binding SaveCommand}" Background="#4F46E5" Foreground="White"
                    BorderBrush="#4F46E5" />
        </StackPanel>
    </Grid>
</Window>
