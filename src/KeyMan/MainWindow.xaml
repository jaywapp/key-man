<Window x:Class="KeyMan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyMan" Height="680" Width="1040" MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="KeyMan" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="개발용 키와 토큰을 한곳에서 안전하게 관리하세요."
                           Foreground="#64748B" FontSize="14" Margin="0,5,0,0" />
            </StackPanel>
            <Button Content="+ 새 키 추가" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding AddCommand}" Background="#4F46E5" Foreground="White" BorderBrush="#4F46E5" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,26,0,16">
            <TextBox x:Name="SearchTextBox" Height="40" VerticalContentAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="이름, 서비스, 환경 검색" Foreground="#94A3B8" Margin="11,0,0,0"
                       IsHitTestVisible="False" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <Grid>
                <DataGrid AutoGenerateColumns="False" IsReadOnly="True"
                          ItemsSource="{Binding EntriesView}" SelectedItem="{Binding SelectedEntry}"
                          SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          BorderThickness="0" RowHeaderWidth="0" AlternatingRowBackground="#F8FAFC">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="서비스" Binding="{Binding Service}" Width="1.4*" />
                        <DataGridTextColumn Header="환경" Binding="{Binding Environment}" Width="1.2*" />
                        <DataGridTextColumn Header="만료" Binding="{Binding ExpirationStatus}" Width="1.2*" />
                        <DataGridTextColumn Header="메모" Binding="{Binding Notes}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="아직 저장된 키가 없습니다." FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="새 키 추가로 첫 항목을 만들어 보세요." Foreground="#64748B" Margin="0,7,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock VerticalAlignment="Center" Foreground="#475569" Text="{Binding StatusText}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="값 복사" Command="{Binding CopyCommand}" />
                <Button Content="삭제" Command="{Binding DeleteCommand}" Foreground="#B91C1C" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
