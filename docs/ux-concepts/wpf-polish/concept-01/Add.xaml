<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="새 키 추가 · Clear Desk 미리보기" Width="500" Height="660" MinWidth="460" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="#F3F5F8" Foreground="#172334" FontFamily="Segoe UI, Malgun Gothic" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#B5C1D2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/></Style>
        <Style TargetType="Label"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Foreground" Value="#43526A"/></Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="76"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#25364B"/><Setter Property="BorderBrush" Value="#C7D0DD"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1C52AB"/><Setter Property="Foreground" Value="White"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#143F83"/><Setter Property="Foreground" Value="White"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#172334"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20"><TextBlock Text="새 키 또는 토큰" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="민감값은 Windows 자격 증명 관리자에 저장됩니다." Foreground="#56657A" Margin="0,7,0,0" TextWrapping="Wrap"/><TextBlock Text="디자인 미리보기입니다. 실제 키를 입력하지 마세요." Foreground="#56657A" FontSize="11" Margin="0,5,0,0"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <Label Content="이름 *" Target="{Binding ElementName=NameField}"/><TextBox x:Name="NameField" Margin="0,0,0,14"/>
                <Label Content="서비스" Target="{Binding ElementName=ServiceField}"/><TextBox x:Name="ServiceField" Margin="0,0,0,14"/>
                <Label Content="환경" Target="{Binding ElementName=EnvironmentField}"/><ComboBox x:Name="EnvironmentField" IsEditable="True" Padding="8" Margin="0,0,0,14"/>
                <Label Content="키 / 토큰 *" Target="{Binding ElementName=SecretField}"/><PasswordBox x:Name="SecretField" Padding="10,8" BorderBrush="#B5C1D2" BorderThickness="1" Margin="0,0,0,14"/>
                <Label Content="만료일 (선택)" Target="{Binding ElementName=ExpirationField}"/><DatePicker x:Name="ExpirationField" Padding="5" Margin="0,0,0,14"/>
                <Label Content="메모" Target="{Binding ElementName=NotesField}"/><TextBox x:Name="NotesField" Height="62" AcceptsReturn="True" TextWrapping="Wrap"/>
                <TextBlock x:Name="ErrorLabel" Foreground="#A12B36" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button x:Name="CancelButton" Content="취소" IsCancel="True" Margin="0,0,8,0"/><Button x:Name="SaveButton" Content="저장" Background="#245FC1" Foreground="White" BorderBrush="#245FC1" FontWeight="SemiBold"/></StackPanel>
    </Grid>
</Window>
