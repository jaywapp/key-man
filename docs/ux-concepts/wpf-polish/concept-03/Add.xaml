<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="새 키 추가" Width="500" Height="660" MinWidth="500" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#FFFFFF" Foreground="#183C2A"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#183C2A" /><Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" /><Setter Property="Foreground" Value="#183C2A" />
            <Setter Property="BorderBrush" Value="#7A9081" /><Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="10,7" /><Setter Property="MinHeight" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate></Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#668674" /></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#245B3E" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#F1F4F2" /><Setter Property="Foreground" Value="#718078" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FFFFFF" /><Setter Property="Foreground" Value="#183C2A" />
            <Setter Property="BorderBrush" Value="#7A9081" /><Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="10,7" /><Setter Property="MinHeight" Value="36" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate></Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#668674" /></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#245B3E" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#F1F4F2" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="8,5" />
            <Setter Property="Foreground" Value="#183C2A" /><Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#7A9081" /><Setter Property="BorderThickness" Value="2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#668674" /></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#245B3E" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="5,3" />
            <Setter Property="Foreground" Value="#183C2A" /><Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#7A9081" /><Setter Property="BorderThickness" Value="2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#668674" /></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#245B3E" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="40" /><Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="18,9" /><Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#183C2A" /><Setter Property="BorderBrush" Value="#7A9081" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Grid>
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <Border x:Name="FocusIndicator" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" CornerRadius="2" Margin="4" Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusIndicator" Property="Opacity" Value="1" /></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EEF4F0" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#DCE9E0" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#F1F4F2" /><Setter Property="Foreground" Value="#718078" /><Setter Property="BorderBrush" Value="#D4DCD6" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#245B3E" /><Setter Property="Foreground" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#245B3E" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#194B31" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#123C26" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#E6ECE8" /><Setter Property="Foreground" Value="#718078" /><Setter Property="BorderBrush" Value="#D4DCD6" /></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="새 키 또는 토큰" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="민감값은 Windows 자격 증명 관리자에 저장됩니다." FontSize="12" Foreground="#52685A" Margin="0,7,0,0" />
            <TextBlock Text="디자인 미리보기입니다. 실제 키는 입력하지 마세요." FontSize="12" Foreground="#52685A" Margin="0,5,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel>
                <Label Content="이름 *" Target="{Binding ElementName=NameField}" />
                <TextBox x:Name="NameField" Margin="0,0,0,12" MaxLength="100" AutomationProperties.Name="이름, 필수" />
                <Label Content="서비스" Target="{Binding ElementName=ServiceField}" />
                <TextBox x:Name="ServiceField" Margin="0,0,0,12" MaxLength="100" AutomationProperties.Name="서비스" />
                <Label Content="환경" Target="{Binding ElementName=EnvironmentField}" />
                <ComboBox x:Name="EnvironmentField" IsEditable="True" Text="Development" Margin="0,0,0,12" AutomationProperties.Name="환경" />
                <Label Content="키 / 토큰 *" Target="{Binding ElementName=SecretField}" />
                <PasswordBox x:Name="SecretField" Margin="0,0,0,12" MaxLength="1280" AutomationProperties.Name="키 또는 토큰, 필수" />
                <Label Content="만료일 (선택)" Target="{Binding ElementName=ExpirationField}" />
                <DatePicker x:Name="ExpirationField" SelectedDateFormat="Short" Margin="0,0,0,12" AutomationProperties.Name="만료일, 선택" />
                <Label Content="메모" Target="{Binding ElementName=NotesField}" />
                <TextBox x:Name="NotesField" Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MaxLength="500" AutomationProperties.Name="메모" />
                <TextBlock x:Name="ErrorLabel" Foreground="#9B3434" FontSize="12" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="#D7E0DA" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="취소" IsCancel="True" Margin="0,0,10,0" />
                <Button x:Name="SaveButton" Content="저장" Style="{StaticResource PrimaryButton}" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
