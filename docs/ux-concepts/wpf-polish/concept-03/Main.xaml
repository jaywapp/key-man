<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyMan" Width="1040" Height="680" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#FFFFFF" Foreground="#183C2A"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#183C2A" />
            <Setter Property="BorderBrush" Value="#7A9081" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="FocusIndicator" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1"
                                CornerRadius="2" Margin="4" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusIndicator" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EEF4F0" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#DCE9E0" /></Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F1F4F2" />
                    <Setter Property="Foreground" Value="#718078" />
                    <Setter Property="BorderBrush" Value="#D4DCD6" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#245B3E" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#245B3E" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#194B31" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#123C26" /></Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E6ECE8" />
                    <Setter Property="Foreground" Value="#718078" />
                    <Setter Property="BorderBrush" Value="#D4DCD6" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#183C2A" />
            <Setter Property="BorderBrush" Value="#7A9081" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#668674" /></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#245B3E" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#F1F4F2" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#183C2A" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="14,16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F2F6F3" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E4F0E7" /></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#245B3E" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,28">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="KeyMan" FontSize="36" FontWeight="SemiBold" />
                <TextBlock Text="개발용 키와 토큰을 한곳에서 관리하세요." Foreground="#52685A" Margin="0,6,0,0" />
            </StackPanel>
            <Button x:Name="AddButton" Grid.Column="1" Content="새 키 추가" Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Center" Margin="24,0,0,0" AutomationProperties.Name="새 키 추가" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Label Content="검색" Target="{Binding ElementName=SearchBox}" VerticalAlignment="Center" Padding="0"
                   FontWeight="SemiBold" />
            <Grid Grid.Column="1">
                <TextBox x:Name="SearchBox" Height="44" AutomationProperties.Name="이름, 서비스, 환경 검색" />
                <TextBlock Text="이름, 서비스, 환경으로 찾기" Foreground="#52685A" Margin="14,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border BorderBrush="#B7C5BB" BorderThickness="0,0,0,1" Padding="16,0,32,12">
                <Grid TextElement.Foreground="#52685A">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="이름 / 메모" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="서비스" FontSize="12" />
                    <TextBlock Grid.Column="2" Text="환경" FontSize="12" />
                    <TextBlock Grid.Column="3" Text="만료" FontSize="12" />
                </Grid>
            </Border>
            <ListBox x:Name="KeyList" Grid.Row="1" BorderThickness="0" Background="#FFFFFF"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionMode="Single" Padding="0,6,0,0" AutomationProperties.Name="보관한 키 목록">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                <TextBlock Text="{Binding Notes}" Foreground="#52685A" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notes}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Service}" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Service}" />
                            <TextBlock Grid.Column="2" Text="{Binding Environment}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Environment}" />
                            <TextBlock Grid.Column="3" Text="{Binding ExpirationStatus}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExpirationStatus}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=KeyList}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="표시할 키가 없습니다." FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="검색어를 바꾸거나 새 키를 추가하세요." Foreground="#52685A" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLabel" Text="키 목록을 확인하세요." Foreground="#52685A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,20,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CopyButton" Content="값 복사" Margin="0,0,10,0" />
                <Button x:Name="DeleteButton" Content="삭제" Foreground="#9B3434" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
